# Copier vers .env (gitignored). Postgres + MinIO sont hébergés sur Coolify (serveur Earth).
PG_URL=postgres://postgres:<password>@167.233.230.65:5432/postgres
PG_CA_CERT=../infra/coolify-ca.crt

MINIO_ENDPOINT=https://minio-9000-<uuid>.earth.zepolclem.dev
MINIO_ACCESS_KEY=<access-key>
MINIO_SECRET_KEY=<secret-key>
MINIO_BUCKET=oscaria-images

# Débit : ~40 req/min = stable. Le proxy n'est PAS nécessaire à ce rythme (secours seulement).
RATE_SLEEP=1.5
IMG_BATCH=200
